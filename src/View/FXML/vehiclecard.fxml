<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="260.0" prefWidth="250.0" spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #E0E0E0; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.VehicleCardController">
   <children>
      <!-- Car Image Container -->
      <StackPane fx:id="imageContainer" prefHeight="130.0" prefWidth="220.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 8;">
         <children>
            <ImageView fx:id="carImageView" fitHeight="130.0" fitWidth="220.0" pickOnBounds="true" preserveRatio="true" style="-fx-background-color: white; -fx-background-radius: 8;" />
            <Button fx:id="btnChangeImage" mnemonicParsing="false" onAction="#handleChangeImage" style="-fx-background-color: rgba(220, 20, 60, 0.9); -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 5 10; -fx-background-radius: 20; -fx-cursor: hand; -fx-opacity: 0;" text="📷" StackPane.alignment="TOP_RIGHT">
               <StackPane.margin>
                  <Insets right="5.0" top="5.0" />
               </StackPane.margin>
            </Button>
         </children>
      </StackPane>
      
      <!-- Car Details -->
      <VBox alignment="CENTER" spacing="5.0">
         <children>
            <Label fx:id="lblMakeModel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Car Model" />
            <HBox alignment="CENTER" spacing="8.0">
               <children>
                  <Label fx:id="lblYear" style="-fx-background-color: #DC143C; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 3 8; -fx-background-radius: 10;" text="2024" />
                  <Label fx:id="lblColor" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 3 8; -fx-background-radius: 10;" text="Black" />
               </children>
            </HBox>
            <Label fx:id="lblPlate" style="-fx-font-size: 13px; -fx-text-fill: #495057; -fx-font-weight: 600;" text="🚗 ABC-1234" />
         </children>
      </VBox>
      
      <Region VBox.vgrow="ALWAYS" />
      
      <!-- Action Buttons -->
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Button fx:id="btnEdit" mnemonicParsing="false" onAction="#handleEdit" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 6 12; -fx-background-radius: 6; -fx-cursor: hand;" text="Edit" />
            <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#handleDelete" prefHeight="30.0" prefWidth="80.0" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 6 12; -fx-background-radius: 6; -fx-cursor: hand;" text="Delete" />
         </children>
      </HBox>
   </children>
</VBox>