<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="600.0" minWidth="800.0" prefHeight="832.0" prefWidth="1547.0" style="-fx-background-color: #f5f5f5;" stylesheets="@../../Model/application.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.CustomerManagementController">
   <children>
      <!-- Left Navigation Sidebar -->
      <VBox alignment="TOP_CENTER" maxWidth="220.0" minWidth="220.0" spacing="5.0" style="-fx-background-color: linear-gradient(to bottom, #DC143C, #8B0000);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="12.0" left="12.0" right="12.0" top="15.0" />
         </padding>
         
         <ImageView fitHeight="55.0" fitWidth="140.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@../pics/1000098939.png" />
            </image>
         </ImageView>
         
         <Separator style="-fx-background-color: rgba(255,255,255,0.3);">
            <VBox.margin>
               <Insets bottom="10.0" top="8.0" />
            </VBox.margin>
         </Separator>
         
         <!-- Dashboard Button -->
         <Button fx:id="btnDashboard" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleBack" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand;" text="Dashboard">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="🏠" />
            </graphic>
            <VBox.margin>
               <Insets bottom="8.0" />
            </VBox.margin>
         </Button>
         
         <!-- User Management Button -->
         <Button fx:id="btnUserManagement" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleUserManagement" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand;" text="User Management">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="👥" />
            </graphic>
            <VBox.margin>
               <Insets bottom="8.0" />
            </VBox.margin>
         </Button>
         
         <!-- Employee Management Button -->
         <Button fx:id="btnEmployeeManagement" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleEmployeeManagement" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand;" text="Employee">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="👔" />
            </graphic>
            <VBox.margin>
               <Insets bottom="8.0" />
            </VBox.margin>
         </Button>
         
         <!-- Customer Button (Active) -->
         <Button fx:id="btnCustomerManagement" alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand;" text="Customer">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="👤" />
            </graphic>
            <VBox.margin>
               <Insets bottom="8.0" />
            </VBox.margin>
         </Button>
         
         <!-- Service Booking Button -->
         <Button fx:id="btnServiceBooking" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleServiceBooking" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand;" text="Service Booking">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="📅" />
            </graphic>
            <VBox.margin>
               <Insets bottom="8.0" />
            </VBox.margin>
         </Button>
         
         <!-- Inventory Button -->
         <Button fx:id="btnInventory" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleInventoryManagement" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand;" text="Inventory">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="📦" />
            </graphic>
            <VBox.margin>
               <Insets bottom="8.0" />
            </VBox.margin>
         </Button>
         
         <!-- Sales Button -->
         <Button fx:id="btnSales" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleSalesManagement" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand;" text="Sales">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="💰" />
            </graphic>
            <VBox.margin>
               <Insets bottom="8.0" />
            </VBox.margin>
         </Button>
         
         <!-- Transactions Button -->
         <Button fx:id="btnTransactions" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleTransactions" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand;" text="Transactions">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="📋" />
            </graphic>
            <VBox.margin>
               <Insets bottom="8.0" />
            </VBox.margin>
         </Button>
         
         <!-- Spacer to push logout to bottom -->
         <Region minHeight="20.0" VBox.vgrow="ALWAYS" />
         
         <Separator style="-fx-background-color: rgba(255,255,255,0.3);">
            <VBox.margin>
               <Insets bottom="10.0" top="10.0" />
            </VBox.margin>
         </Separator>
         
         <!-- Logout Button -->
         <Button fx:id="btnLogout" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: rgba(255,0,0,0.3); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.3); -fx-border-width: 1; -fx-border-radius: 8;" text="Logout">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="🚪" />
            </graphic>
         </Button>
      </VBox>
      
      <!-- Main Content Area -->
      <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: #f5f5f5;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="220.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <content>
            <VBox spacing="25.0" style="-fx-background-color: #f5f5f5;">
               <padding>
                  <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
               </padding>
               
               <!-- Search and Action Bar -->
         <HBox alignment="CENTER_LEFT" spacing="18.0" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3);">
            <Label style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #2c3e50;" text="🔍" />
            <TextField fx:id="txtSearch" prefWidth="350.0" promptText="Search by name, email, or phone..." style="-fx-background-color: #f8f9fa; -fx-border-color: #e9ecef; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 15; -fx-font-size: 14px;" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnSearch" onAction="#handleSearch" style="-fx-background-color: #DC143C; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;" text="Search" />
            <Button fx:id="btnRefreshCustomers" onAction="#handleRefreshCustomers" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;" text="🔄 Refresh" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnAddCustomer" onAction="#handleAddCustomer" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;" text="+ Add Customer" />
            <Label fx:id="lblCustomerCount" style="-fx-font-size: 13px; -fx-text-fill: #6c757d; -fx-font-weight: 600; -fx-background-color: #f8f9fa; -fx-padding: 8 15; -fx-background-radius: 20;" text="Total: 0" />
         </HBox>
         
         <!-- Customer Table -->
         <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3); -fx-padding: 20;" VBox.vgrow="ALWAYS">
            <!-- Table Header -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="👥 Customer Directory">
                  <font>
                     <Font name="System Bold" size="20.0" />
                  </font>
               </Label>
               <Region HBox.hgrow="ALWAYS" />
            </HBox>
            
            <Separator style="-fx-background-color: #e9ecef;" />
            
            <!-- Modern Borderless Table -->
            <TableView fx:id="tableCustomers" VBox.vgrow="ALWAYS">
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <columns>
                  <TableColumn fx:id="colCustomerId" maxWidth="80.0" minWidth="60.0" prefWidth="70.0" resizable="true" text="ID" />
                  <TableColumn fx:id="colCustomerName" minWidth="150.0" prefWidth="200.0" resizable="true" text="Customer Name" />
                  <TableColumn fx:id="colCustomerEmail" minWidth="180.0" prefWidth="250.0" resizable="true" text="Email Address" />
                  <TableColumn fx:id="colCustomerPhone" minWidth="120.0" prefWidth="150.0" resizable="true" text="Phone Number" />
                  <TableColumn fx:id="colCustomerAddress" minWidth="200.0" prefWidth="250.0" resizable="true" text="Address" />
                  <TableColumn fx:id="colActions" maxWidth="280.0" minWidth="240.0" prefWidth="250.0" resizable="true" sortable="false" text="Actions" />
               </columns>
            </TableView>
            </VBox>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</AnchorPane>
