<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="750.0" prefWidth="1100.0" style="-fx-background-color: #F3F4F6; -fx-font-family: 'Segoe UI';" stylesheets="@../style/dialog-styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.ServiceBookingDialogController">

    <!-- Sticky Header Section -->
    <VBox spacing="5.0" style="-fx-background-color: white; -fx-padding: 20 25; -fx-border-color: #E5E7EB; -fx-border-width: 0 0 1 0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 4, 0, 0, 2);">
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Service Booking Details" />
        <Label style="-fx-font-size: 13px; -fx-text-fill: #64748B;" text="Fill in the form to add or update a booking." />
    </VBox>

    <!-- Scrollable Content Area -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #F3F4F6;" VBox.vgrow="ALWAYS">
        <content>
            <HBox spacing="25.0">
                <padding>
                    <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                </padding>

                <!-- Left Column: Booking Info & Payment -->
                <VBox maxWidth="Infinity" prefWidth="480.0" spacing="20.0" HBox.hgrow="ALWAYS">
                    
                    <!-- Booking Information Card -->
                    <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 2);">
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Booking Information" />
                        <Separator style="-fx-background-color: #E5E7EB;" />

                        <VBox spacing="5.0">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Customer Name:" />
                            <TextField fx:id="txtCustomerName" promptText="Type or select customer name..." style="-fx-padding: 8; -fx-background-radius: 6; -fx-border-color: #CBD5E1; -fx-border-radius: 6;" />
                            <!-- The ListView overlay for autocomplete results -->
                            <ListView fx:id="listCustomerSuggestions" managed="false" prefHeight="100.0" style="-fx-border-color: #CBD5E1; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 4);" visible="false" />
                        </VBox>

                        <VBox spacing="5.0">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Vehicle Details:" />
                            <ComboBox fx:id="cmbCarDetails" editable="true" maxWidth="Infinity" promptText="Select customer's vehicle..." style="-fx-padding: 4; -fx-background-radius: 6; -fx-border-color: #CBD5E1; -fx-border-radius: 6;" />
                            <ListView fx:id="listCarSuggestions" managed="false" prefHeight="100.0" style="-fx-border-color: #CBD5E1; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 4);" visible="false" />
                        </VBox>

                        <HBox spacing="15.0">
                            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Booking Date:" />
                                <DatePicker fx:id="datePicker" maxWidth="Infinity" style="-fx-padding: 4; -fx-background-radius: 6; -fx-border-color: #CBD5E1; -fx-border-radius: 6;" />
                            </VBox>
                            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Status:" />
                                <ComboBox fx:id="cmbStatus" maxWidth="Infinity" promptText="Set Status" style="-fx-padding: 4; -fx-background-radius: 6; -fx-border-color: #CBD5E1; -fx-border-radius: 6;" />
                            </VBox>
                        </HBox>

                        <VBox spacing="5.0">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Notes:" />
                            <TextArea fx:id="txtNotes" prefHeight="70.0" promptText="Additional notes..." style="-fx-background-radius: 6; -fx-border-color: #CBD5E1; -fx-border-radius: 6;" wrapText="true" />
                        </VBox>
                    </VBox>

                    <!-- Payment Details Card -->
                    <VBox spacing="15.0" style="-fx-background-color: #FEF2F2; -fx-background-radius: 8; -fx-border-color: #FECDD3; -fx-border-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 2);">
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #DC143C;" text="Payment Details" />
                        <Separator style="-fx-background-color: #FECDD3;" />

                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Total Amount:" HBox.hgrow="ALWAYS" />
                            <Region HBox.hgrow="ALWAYS" />
                            <TextField fx:id="txtTotalAmount" alignment="CENTER_RIGHT" editable="false" prefWidth="150.0" style="-fx-background-color: #F1F5F9; -fx-font-weight: bold; -fx-padding: 8; -fx-border-color: #CBD5E1; -fx-border-radius: 4; -fx-text-fill: #334155;" text="0.00" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #475569;" text="Downpayment:" HBox.hgrow="ALWAYS" />
                            <Region HBox.hgrow="ALWAYS" />
                            <TextField fx:id="txtDownpayment" alignment="CENTER_RIGHT" prefWidth="150.0" promptText="0.00" style="-fx-padding: 8; -fx-border-color: #CBD5E1; -fx-border-radius: 4;" text="0.00" />
                        </HBox>

                        <HBox alignment="CENTER_LEFT">
                            <Label style="-fx-font-weight: bold; -fx-text-fill: #DC143C;" text="Balance:" HBox.hgrow="ALWAYS" />
                            <Region HBox.hgrow="ALWAYS" />
                            <TextField fx:id="txtBalance" alignment="CENTER_RIGHT" editable="false" prefWidth="150.0" style="-fx-background-color: #F1F5F9; -fx-font-weight: bold; -fx-text-fill: #DC143C; -fx-padding: 8; -fx-border-color: #CBD5E1; -fx-border-radius: 4;" text="0.00" />
                        </HBox>
                    </VBox>

                    <!-- Products / Parts Card (Moved to Left Column for balance) -->
                    <VBox spacing="16.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 2);" VBox.vgrow="ALWAYS">
                        <VBox spacing="4.0">
                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Products / Parts Used" />
                            <Label style="-fx-font-size: 12px; -fx-text-fill: #64748B;" text="Automatically pulled from POS transactions." />
                        </VBox>
                        
                        <TableView fx:id="tblProducts" minHeight="140.0" prefHeight="150.0" style="-fx-border-color: #E5E7EB; -fx-border-radius: 6; -fx-background-radius: 6; -fx-fixed-cell-size: 36; -fx-font-size: 13px;" VBox.vgrow="ALWAYS">
                            <placeholder>
                                <VBox alignment="CENTER" spacing="8.0">
                                    <Label style="-fx-font-size: 24px; -fx-text-fill: #CBD5E1;" text="📦" />
                                    <Label style="-fx-font-size: 13px; -fx-text-fill: #94A3B8;" text="No parts added from POS." />
                                </VBox>
                            </placeholder>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                            <columns>
                                <TableColumn fx:id="colProductName" style="-fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 10;" text="Product Name" />
                                <TableColumn fx:id="colQuantity" maxWidth="70.0" minWidth="70.0" style="-fx-alignment: CENTER;" text="Qty" />
                                <TableColumn fx:id="colUnitPrice" maxWidth="120.0" minWidth="120.0" style="-fx-alignment: CENTER-RIGHT; -fx-padding: 0 10 0 0;" text="Unit Price" />
                            </columns>
                        </TableView>
                    </VBox>

                </VBox>

                <!-- Right Column: Services, Staff -->
                <VBox maxWidth="Infinity" prefWidth="550.0" spacing="20.0" HBox.hgrow="ALWAYS">
                    
                    <!-- Services Card -->
                    <VBox spacing="16.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 2);" VBox.vgrow="ALWAYS">
                        
                        <!-- Header and Subtitle -->
                        <VBox spacing="4.0">
                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Service Type(s)" />
                            <Label style="-fx-font-size: 12px; -fx-text-fill: #64748B;" text="Search and add requested services for this booking." />
                        </VBox>
                        
                        <!-- Search and Add Action Row -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <ComboBox fx:id="cmbServiceTypeSearch" editable="true" maxWidth="Infinity" promptText="e.g. Oil Change, Brake Inspection..." style="-fx-padding: 6; -fx-font-size: 13px; -fx-background-radius: 6; -fx-border-color: #CBD5E1; -fx-border-radius: 6;" HBox.hgrow="ALWAYS" />
                            <Button fx:id="btnAddService" onAction="#handleAddService" prefWidth="90.0" style="-fx-background-color: #3B82F6; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 7 16; -fx-background-radius: 6; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(59, 130, 246, 0.3), 4, 0, 0, 2);" text="+ Add" />
                        </HBox>
                        
                        <!-- Selected Services List -->
                        <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Added Services" />
                            <TableView fx:id="tblServiceTypes" minHeight="140.0" prefHeight="150.0" style="-fx-border-color: #E5E7EB; -fx-border-radius: 6; -fx-background-radius: 6; -fx-fixed-cell-size: 36; -fx-font-size: 13px;" VBox.vgrow="ALWAYS">
                                <placeholder>
                                    <VBox alignment="CENTER" spacing="8.0">
                                        <Label style="-fx-font-size: 24px; -fx-text-fill: #CBD5E1;" text="🔧" />
                                        <Label style="-fx-font-size: 13px; -fx-text-fill: #94A3B8;" text="No services added yet." />
                                    </VBox>
                                </placeholder>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="colServiceName" style="-fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 10;" text="Service Name" />
                                    <TableColumn fx:id="colServiceAction" maxWidth="70.0" minWidth="70.0" style="-fx-alignment: CENTER;" text="Action" />
                                </columns>
                            </TableView>
                            <HBox alignment="CENTER_RIGHT">
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #94A3B8; -fx-font-style: italic;" text="Added services will seamlessly appear in the list above." />
                            </HBox>
                        </VBox>

                    </VBox>

                    <!-- Assigned Staff Card -->
                    <VBox spacing="16.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 2);" VBox.vgrow="ALWAYS">
                        
                        <!-- Header and Subtitle -->
                        <VBox spacing="4.0">
                            <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Assigned Staff" />
                            <Label style="-fx-font-size: 12px; -fx-text-fill: #64748B;" text="Search and add staff members for this booking." />
                        </VBox>
                        
                        <VBox spacing="0">
                            <!-- Search and Add Action Row -->
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <ComboBox fx:id="cmbEmployeeSearch" editable="true" maxWidth="Infinity" promptText="Search employee by name or role..." style="-fx-padding: 6; -fx-font-size: 13px; -fx-background-radius: 6; -fx-border-color: #CBD5E1; -fx-border-radius: 6;" HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnAddEmployee" onAction="#handleAddEmployee" prefWidth="90.0" style="-fx-background-color: #3B82F6; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 7 16; -fx-background-radius: 6; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(59, 130, 246, 0.3), 4, 0, 0, 2);" text="+ Add" />
                            </HBox>
                            <!-- The ListView overlay for autocomplete results -->
                            <ListView fx:id="listEmployeeSuggestions" managed="false" prefHeight="100.0" style="-fx-border-color: #CBD5E1; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 4);" visible="false" />
                        </VBox>

                        <!-- Selected Staff List -->
                        <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Assigned Staff Members" />
                            <TableView fx:id="tblAssignedEmployees" minHeight="140.0" prefHeight="150.0" style="-fx-border-color: #E5E7EB; -fx-border-radius: 6; -fx-background-radius: 6; -fx-fixed-cell-size: 36; -fx-font-size: 13px;" VBox.vgrow="ALWAYS">
                                <placeholder>
                                    <VBox alignment="CENTER" spacing="8.0">
                                        <Label style="-fx-font-size: 24px; -fx-text-fill: #CBD5E1;" text="👥" />
                                        <Label style="-fx-font-size: 13px; -fx-text-fill: #94A3B8;" text="No staff members assigned yet." />
                                    </VBox>
                                </placeholder>
                                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                <columns>
                                    <TableColumn fx:id="colEmployeeName" style="-fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 10;" text="Employee Name" />
                                    <TableColumn fx:id="colEmployeeRole" style="-fx-alignment: CENTER-LEFT;" text="Role/Position" />
                                    <TableColumn fx:id="colEmployeeAction" maxWidth="70.0" minWidth="70.0" style="-fx-alignment: CENTER;" text="Action" />
                                </columns>
                            </TableView>
                            <HBox alignment="CENTER_RIGHT">
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #94A3B8; -fx-font-style: italic;" text="Assigned staff will seamlessly appear in the list above." />
                            </HBox>
                        </VBox>
                    </VBox>

                </VBox>
            </HBox>
        </content>
    </ScrollPane>

    <!-- Sticky Action Buttons -->
    <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 15 25; -fx-border-color: #E5E7EB; -fx-border-width: 1 0 0 0;">
        <Button fx:id="btnCancel" onAction="#handleCancel" prefHeight="30.0" prefWidth="120.0" style="-fx-background-color: white; -fx-border-color: #CBD5E1; -fx-border-radius: 6; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" text="Cancel" />
        <Button fx:id="btnSave" onAction="#handleSave" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" text="Save Booking" />
    </HBox>

</VBox>
