<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" style="-fx-background-color: #ffffff; -fx-padding: 20;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.StockInDialogController">
   <children>
      <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="📦 Stock-In Product" />
      
      <VBox spacing="5.0" style="-fx-background-color: #f8f9fa; -fx-padding: 10; -fx-background-radius: 5;">
         <Label fx:id="lblProductName" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Product Name" />
         <Label fx:id="lblCurrentStock" style="-fx-text-fill: #6c757d;" text="Current Stock: 0" />
      </VBox>

      <VBox spacing="5.0">
         <Label style="-fx-font-weight: bold;" text="Quantity to Add *" />
         <TextField fx:id="txtQuantity" promptText="Enter quantity (e.g., 50)" />
      </VBox>

      <VBox spacing="5.0">
         <Label style="-fx-font-weight: bold;" text="Delivery Reference Number" />
         <TextField fx:id="txtReferenceNumber" promptText="Enter invoice or delivery ID" />
      </VBox>

      <VBox spacing="5.0">
         <Label style="-fx-font-weight: bold;" text="Supplier" />
         <TextField fx:id="txtSupplier" promptText="Enter supplier name" />
      </VBox>

      <VBox spacing="5.0">
         <Label style="-fx-font-weight: bold;" text="Notes" />
         <TextArea fx:id="txtNotes" prefRowCount="3" promptText="Any optional delivery notes..." />
      </VBox>

      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
         <Button fx:id="btnCancel" onAction="#handleCancel" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16; -fx-cursor: hand;" text="Cancel" />
         <Button fx:id="btnSave" onAction="#handleSave" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 16; -fx-cursor: hand;" text="Save Stock-In" />
      </HBox>
   </children>
</VBox>
