                              <Label style="-fx-font-size: 13px; -fx-text-fill: #94A3B8;" text="No scheduled appointments found." />
                           </VBox>
                        </placeholder>
                        <columnResizePolicy>
                           <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <columns>
                           <TableColumn fx:id="colBookingId" maxWidth="80.0" minWidth="50.0" prefWidth="60.0" resizable="true" style="-fx-alignment: CENTER;" text="ID" />
                           <TableColumn fx:id="colBookingNumber" minWidth="120.0" prefWidth="130.0" resizable="true" style="-fx-alignment: CENTER;" text="Booking #" />
                           <TableColumn fx:id="colCustomerName" minWidth="130.0" prefWidth="150.0" resizable="true" style="-fx-alignment: CENTER;" text="Customer" />
                           <TableColumn fx:id="colCarInfo" minWidth="150.0" prefWidth="180.0" resizable="true" style="-fx-alignment: CENTER;" text="Vehicle" />
                           <TableColumn fx:id="colBookingDate" minWidth="90.0" prefWidth="100.0" resizable="true" style="-fx-alignment: CENTER;" text="Date" />
                           <TableColumn fx:id="colBookingTime" minWidth="70.0" prefWidth="80.0" resizable="true" style="-fx-alignment: CENTER;" text="Time" />
                           <TableColumn fx:id="colStatus" minWidth="90.0" prefWidth="100.0" resizable="true" style="-fx-alignment: CENTER;" text="Status" />
                        </columns>
                     </TableView>
                     <HBox alignment="CENTER_RIGHT">
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #94A3B8; -fx-font-style: italic;" text="Appointments will seamlessly appear in the list above." />
                     </HBox>
                  </VBox>
                  
                  <!-- Action Buttons -->
                  <HBox alignment="CENTER_LEFT" spacing="14.0" style="-fx-padding: 6 0 0 0;">
                     <Button fx:id="btnViewDetails" onAction="#handleViewDetails" style="-fx-background-color: #6f42c1; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 18; -fx-background-radius: 6; -fx-cursor: hand;" text="View Details" />
                     <Button fx:id="btnEditBooking" onAction="#handleEditBooking" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 18; -fx-background-radius: 6; -fx-cursor: hand;" text="Edit" />
                     <Button fx:id="btnCompleteBooking" onAction="#handleCompleteBooking" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 18; -fx-background-radius: 6; -fx-cursor: hand;" text="Complete" />
                     <Button fx:id="btnCancelBooking" onAction="#handleCancelBooking" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 18; -fx-background-radius: 6; -fx-cursor: hand;" text="Cancel Booking" />
