                     <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label style="-fx-font-size: 32px;" text="📅" />
                        <VBox spacing="3.0">
                           <Label style="-fx-font-size: 12px; -fx-text-fill: #666666;" text="Total Bookings" />
                           <Label fx:id="lblTotalBookings" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #DC143C;" text="0">
                              <font>
                                 <Font name="System Bold" size="28.0" />
                              </font>
                           </Label>
                        </VBox>
                     </HBox>
                     <Label style="-fx-font-size: 11px; -fx-text-fill: #999999;" text="All appointments" />
                  </VBox>
                  
                  <!-- Scheduled Card -->
                  <VBox alignment="TOP_LEFT" minHeight="130.0" minWidth="200.0" spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-padding: 20;" HBox.hgrow="ALWAYS">
                     <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label style="-fx-font-size: 32px;" text="🕐" />
                        <VBox spacing="3.0">
                           <Label style="-fx-font-size: 12px; -fx-text-fill: #666666;" text="Scheduled" />
                           <Label fx:id="lblScheduled" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #007bff;" text="0">
                              <font>
                                 <Font name="System Bold" size="28.0" />
                              </font>
                           </Label>
                        </VBox>
                     </HBox>
                     <Label style="-fx-font-size: 11px; -fx-text-fill: #999999;" text="Pending appointments" />
                  </VBox>
                  
                  <!-- In Progress Card -->
                  <VBox alignment="TOP_LEFT" minHeight="130.0" minWidth="200.0" spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-padding: 20;" HBox.hgrow="ALWAYS">
                     <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label style="-fx-font-size: 32px;" text="🔧" />
                        <VBox spacing="3.0">
                           <Label style="-fx-font-size: 12px; -fx-text-fill: #666666;" text="In Progress" />
                           <Label fx:id="lblInProgress" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #ffc107;" text="0">
                              <font>
                                 <Font name="System Bold" size="28.0" />
                              </font>
                           </Label>
                        </VBox>
                     </HBox>
                     <Label style="-fx-font-size: 11px; -fx-text-fill: #999999;" text="Currently servicing" />
                  </VBox>
                  
                  <!-- Completed Card -->
                  <VBox alignment="TOP_LEFT" minHeight="130.0" minWidth="200.0" spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-padding: 20;" HBox.hgrow="ALWAYS">
                     <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label style="-fx-font-size: 32px;" text="✅" />
                        <VBox spacing="3.0">
                           <Label style="-fx-font-size: 12px; -fx-text-fill: #666666;" text="Completed" />
                           <Label fx:id="lblCompleted" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #28a745;" text="0">
                              <font>
                                 <Font name="System Bold" size="28.0" />
                              </font>
                           </Label>
                        </VBox>
                     </HBox>
                     <Label style="-fx-font-size: 11px; -fx-text-fill: #999999;" text="Finished today" />
                  </VBox>
                  
                  <!-- Cancelled Card -->
                  <VBox alignment="TOP_LEFT" minHeight="130.0" minWidth="200.0" spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-padding: 20;" HBox.hgrow="ALWAYS">
                     <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label style="-fx-font-size: 32px;" text="❌" />
                        <VBox spacing="3.0">
                           <Label style="-fx-font-size: 12px; -fx-text-fill: #666666;" text="Cancelled" />
                           <Label fx:id="lblCancelled" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #dc3545;" text="0">
                              <font>
                                 <Font name="System Bold" size="28.0" />
                              </font>
                           </Label>
                        </VBox>
                     </HBox>
                     <Label style="-fx-font-size: 11px; -fx-text-fill: #999999;" text="Cancelled bookings" />
                  </VBox>
               </HBox>
               
               <!-- Date Picker and Action Bar -->
               <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                  <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Select Date:" />
                  <DatePicker fx:id="datePicker" prefWidth="200.0" style="-fx-background-radius: 8;" />
                  <Button fx:id="btnRefresh" onAction="#handleRefresh" style="-fx-background-color: #FF6B6B; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 14px;" text="Refresh" />
               </HBox>
               
               <!-- Bookings Table Card -->
               <VBox spacing="16.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 2);" VBox.vgrow="ALWAYS">
                  <VBox spacing="4.0">
                     <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Scheduled Appointments" />
                     <Label style="-fx-font-size: 12px; -fx-text-fill: #64748B;" text="Manage all upcoming and ongoing service appointments." />
