                  <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Customer" />
                  <TextField fx:id="txtCustomer" promptText="Walk-in Customer" style="-fx-background-radius: 6; -fx-padding: 8; -fx-font-size: 13px; -fx-border-color: #E5E7EB; -fx-border-width: 1;" />
                  <javafx.scene.control.ListView fx:id="listCustomerSuggestions" managed="false" prefHeight="100.0" style="-fx-border-color: #CBD5E1; -fx-background-color: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 4);" visible="false" />
               </VBox>
               
               <!-- Cart Items Card -->
               <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 12; -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Cart Items" />
                     <Label fx:id="lblCartCount" style="-fx-font-size: 11px; -fx-text-fill: #DC143C; -fx-background-color: #FFF1F2; -fx-padding: 2 8; -fx-background-radius: 12; -fx-font-weight: bold;" text="0" />
                     <Region HBox.hgrow="ALWAYS" />
                     <Button fx:id="btnClearCart" onAction="#handleClearCart" style="-fx-background-color: transparent; -fx-text-fill: #EF4444; -fx-font-size: 12px; -fx-padding: 0; -fx-cursor: hand;" text="Clear All" />
                  </HBox>
                  
                  <TableView fx:id="tableCart" minHeight="250.0" style="-fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-background-radius: 4; -fx-border-radius: 4; -fx-fixed-cell-size: 40;" VBox.vgrow="ALWAYS">
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <columns>
                        <TableColumn fx:id="colCartProduct" minWidth="180.0" prefWidth="200.0" resizable="true" text="Product" />
                        <TableColumn fx:id="colCartQty" minWidth="45.0" prefWidth="50.0" resizable="true" style="-fx-alignment: CENTER;" text="Qty" />
                        <TableColumn fx:id="colCartPrice" minWidth="65.0" prefWidth="70.0" resizable="true" style="-fx-alignment: CENTER-RIGHT;" text="Price" />
                     </columns>
                  </TableView>
                  
                  <HBox alignment="CENTER_RIGHT">
                     <Button fx:id="btnRemoveItem" onAction="#handleRemoveItem" style="-fx-background-color: #FFF1F2; -fx-text-fill: #EF4444; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 6 12; -fx-background-radius: 6; -fx-cursor: hand;" text="Remove Item" />
                  </HBox>
               </VBox>
               
               <!-- Totals Card -->
               <VBox spacing="10.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 16; -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 8;">
                  <HBox alignment="CENTER_LEFT">
                     <Label style="-fx-font-size: 13px; -fx-text-fill: #64748B;" text="Subtotal" />
                     <Region HBox.hgrow="ALWAYS" />
                     <Label fx:id="lblSubtotal" style="-fx-font-size: 14px; -fx-text-fill: #334155; -fx-alignment: center-right;" text="₱0.00" />
                  </HBox>
                  
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <Label style="-fx-font-size: 13px; -fx-text-fill: #64748B;" text="Discount" />
                     <Region HBox.hgrow="ALWAYS" />
                     <HBox alignment="CENTER_RIGHT" spacing="4.0">
                        <javafx.scene.control.PasswordField fx:id="txtAdminPassword" prefWidth="120.0" promptText="Admin Password" style="-fx-background-radius: 4; -fx-padding: 4 8; -fx-font-size: 13px; -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 4;" />
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #94A3B8;" text="₱" />
                        <TextField fx:id="txtDiscount" prefWidth="90.0" promptText="0.00" style="-fx-background-radius: 4; -fx-padding: 4 8; -fx-font-size: 13px; -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 4; -fx-alignment: center-right;" text="0.00" />
                     </HBox>
                  </HBox>
                  
                  <HBox alignment="CENTER_LEFT">
                     <Label style="-fx-font-size: 13px; -fx-text-fill: #64748B;" text="VAT (12%)" />
                     <Region HBox.hgrow="ALWAYS" />
                     <Label fx:id="lblVat" style="-fx-font-size: 14px; -fx-text-fill: #334155; -fx-alignment: center-right;" text="₱0.00" />
                  </HBox>
                  
                  <Region style="-fx-border-color: #CBD5E1; -fx-border-style: dashed; -fx-border-width: 2 0 0 0;">
                     <VBox.margin>
                        <Insets bottom="2.0" top="2.0" />
                     </VBox.margin>
                  </Region>
                  
                  <HBox alignment="CENTER_LEFT">
                     <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Total" />
