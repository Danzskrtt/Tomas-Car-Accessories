      <!-- Main Content Area without ScrollPane -->
      <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background-color: #f5f5f5;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="220.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
