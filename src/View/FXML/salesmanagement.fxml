         <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 12 16; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-border-width: 1;">
            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
               <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Point of Sale">
                  <font>
                     <Font name="System Bold" size="20.0" />
                  </font>
               </Label>
            </VBox>
            <VBox alignment="CENTER_RIGHT" spacing="3.0">
               <Label fx:id="lblOrderNumber" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #DC143C; -fx-background-color: #FFF1F2; -fx-padding: 6 12; -fx-background-radius: 6;" text="Order #: ORD-0001" />
            </VBox>
         </HBox>
      
