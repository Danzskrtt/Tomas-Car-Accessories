                  <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Quantity:" />
                  <Spinner fx:id="spinnerQuantity" prefWidth="80.0" style="-fx-background-radius: 4;" />
                  <Button fx:id="btnAddToCart" onAction="#handleAddToCart" style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 24; -fx-background-radius: 6; -fx-cursor: hand;" text="Add to Cart" />
               </HBox>
            </VBox>
            
            <!-- Right: Cart & Checkout (40% width) -->
            <VBox maxWidth="420.0" minWidth="420.0" prefWidth="420.0" spacing="12.0" style="-fx-background-color: transparent;">
               
