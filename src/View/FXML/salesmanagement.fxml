               <HBox alignment="CENTER_LEFT" spacing="12.0">
                  <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                     <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Search Products" />
                     <HBox spacing="8.0">
                        <TextField fx:id="txtSearchProduct" promptText="Search by name, code, or scan barcode..." style="-fx-background-radius: 6; -fx-padding: 8; -fx-font-size: 13px; -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 6;" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnSearchProduct" onAction="#handleSearchProduct" style="-fx-background-color: #F8FAFC; -fx-text-fill: #334155; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-border-color: #E5E7EB; -fx-border-radius: 6; -fx-border-width: 1; -fx-cursor: hand;" text="Search" />
                     </HBox>
                  </VBox>
                  
                  <VBox spacing="4.0">
                     <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Category Filter" />
                     <ComboBox fx:id="cmbCategoryFilter" prefWidth="180.0" promptText="All Categories" style="-fx-background-radius: 6; -fx-font-size: 13px; -fx-border-color: #E5E7EB; -fx-border-radius: 6; -fx-border-width: 1;" />
                  </VBox>
               </HBox>
               
               <Separator style="-fx-background-color: #E5E7EB;" />
               
               <!-- Products FlowPane for Cards -->
               <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: white;" vbarPolicy="ALWAYS" VBox.vgrow="ALWAYS">
                  <content>
                     <javafx.scene.layout.FlowPane fx:id="flowPaneProducts" hgap="16.0" style="-fx-padding: 4;" vgap="16.0">
                     </javafx.scene.layout.FlowPane>
                  </content>
               </ScrollPane>
               
               <!-- Add to Cart Section (Simplified) -->
