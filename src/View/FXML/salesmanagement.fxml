                     <Label fx:id="lblTotal" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1E293B; -fx-alignment: center-right;" text="₱0.00" />
                  </HBox>
               </VBox>
               
               <!-- Payment & Actions -->
               <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 16; -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 8;">
                  <VBox spacing="6.0">
                     <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Payment Method" />
                     <ComboBox fx:id="cmbPaymentMethod" maxWidth="Infinity" promptText="Select payment method" style="-fx-background-radius: 6; -fx-font-size: 13px; -fx-border-color: #E5E7EB; -fx-border-width: 1; -fx-border-radius: 6;" />
                  </VBox>
                  
                  <HBox spacing="8.0">
                     <Button fx:id="btnCheckout" maxWidth="Infinity" onAction="#handleCheckout" style="-fx-background-color: #DC143C; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 6; -fx-cursor: hand;" text="Complete Checkout" HBox.hgrow="ALWAYS" />
                  </HBox>
               </VBox>
            </VBox>
         </HBox>
      </VBox>
   </content>
      </ScrollPane>
   </children>
</AnchorPane>
