<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="1000.0" spacing="20.0" style="-fx-background-color: #F8F9FA; -fx-font-family: 'Segoe UI';" stylesheets="@../style/dialog-styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.ServiceHistoryDialogController">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>

    <VBox alignment="CENTER_LEFT" spacing="5.0">
        <Label fx:id="lblTitle" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Service History" />
        <Label style="-fx-font-size: 14px; -fx-text-fill: #7F8C8D;" text="Track past and upcoming service appointments." />
    </VBox>
    
    <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2); -fx-padding: 15;" VBox.vgrow="ALWAYS">
        <TableView fx:id="tblBookings" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colBookingId" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Booking ID" />
                <TableColumn fx:id="colCar" prefWidth="200.0" text="Car Details" />
                <TableColumn fx:id="colServiceType" prefWidth="220.0" text="Service Type" />
                <TableColumn fx:id="colBookingDate" prefWidth="140.0" style="-fx-alignment: CENTER;" text="Date" />
                <TableColumn fx:id="colTotalCost" prefWidth="120.0" style="-fx-alignment: CENTER-RIGHT;" text="Cost" />
                <TableColumn fx:id="colStatus" prefWidth="120.0" style="-fx-alignment: CENTER;" text="Status" />
            </columns>
        </TableView>
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 10 0 0 0;">
        <Button onAction="#handleClose" prefHeight="40.0" prefWidth="120.0" styleClass="button-cancel" text="Close">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Button>
    </HBox>
</VBox>
