<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="700.0" minWidth="1200.0" prefHeight="832.0" prefWidth="1547.0" style="-fx-background-color: #f5f5f5;" stylesheets="@../../Model/application.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.RecentTransactionsController">
   <children>
      <!-- Left Navigation Sidebar -->
      <VBox alignment="TOP_CENTER" maxWidth="220.0" minWidth="220.0" spacing="5.0" style="-fx-background-color: linear-gradient(to bottom, #DC143C, #8B0000);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="12.0" left="12.0" right="12.0" top="15.0" />
         </padding>
         
         <ImageView fitHeight="55.0" fitWidth="140.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@../pics/1000098939.png" />
            </image>
         </ImageView>
         
         <Separator style="-fx-background-color: rgba(255,255,255,0.3);">
            <VBox.margin>
               <Insets bottom="10.0" top="8.0" />
            </VBox.margin>
         </Separator>
         
         <!-- Dashboard Button -->
         <Button fx:id="btnDashboard" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleBack" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand;" text="Dashboard">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="🏠" />
            </graphic>
            <VBox.margin>
               <Insets bottom="8.0" />
            </VBox.margin>
         </Button>
         
         <!-- User Management Button -->
         <Button fx:id="btnUserManagement" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleUserManagement" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand;" text="User Management">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="👥" />
            </graphic>
            <VBox.margin>
               <Insets bottom="8.0" />
            </VBox.margin>
         </Button>
         
         <!-- Employee Management Button -->
         <Button fx:id="btnEmployeeManagement" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleEmployeeManagement" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand;" text="Employee">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="👔" />
            </graphic>
            <VBox.margin>
               <Insets bottom="8.0" />
            </VBox.margin>
         </Button>
         
         <!-- Customer Button -->
         <Button fx:id="btnCustomerManagement" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleCustomerManagement" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand;" text="Customer">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="👤" />
            </graphic>
            <VBox.margin>
               <Insets bottom="8.0" />
            </VBox.margin>
         </Button>
         
         <!-- Service Booking Button -->
         <Button fx:id="btnServiceBooking" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleServiceBooking" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand;" text="Service Booking">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="📅" />
            </graphic>
            <VBox.margin>
               <Insets bottom="8.0" />
            </VBox.margin>
         </Button>
         
         <!-- Inventory Button -->
         <Button fx:id="btnInventory" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleInventoryManagement" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand;" text="Inventory">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="📦" />
            </graphic>
            <VBox.margin>
               <Insets bottom="8.0" />
            </VBox.margin>
         </Button>
         
         <!-- Sales Button -->
         <Button fx:id="btnSales" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleSalesManagement" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand;" text="Sales">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="💰" />
            </graphic>
            <VBox.margin>
               <Insets bottom="8.0" />
            </VBox.margin>
         </Button>
         
         <!-- Transactions Button (Active) -->
         <Button fx:id="btnTransactions" alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand;" text="Transactions">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="📋" />
            </graphic>
            <VBox.margin>
               <Insets bottom="8.0" />
            </VBox.margin>
         </Button>
         
         <!-- Spacer to push logout to bottom -->
         <Region VBox.vgrow="ALWAYS" minHeight="20.0" />
         
         <Separator style="-fx-background-color: rgba(255,255,255,0.3);">
            <VBox.margin>
               <Insets bottom="10.0" top="10.0" />
            </VBox.margin>
         </Separator>
         
         <!-- Logout Button -->
         <Button fx:id="btnLogout" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: rgba(255,0,0,0.3); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.3); -fx-border-width: 1; -fx-border-radius: 8;" text="Logout">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="🚪" />
            </graphic>
         </Button>
      </VBox>
      
      <!-- Main Content Area -->
      <ScrollPane fitToWidth="true" style="-fx-background-color: #f5f5f5;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="220.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <content>
            <VBox spacing="25.0" style="-fx-background-color: #f5f5f5;">
               <padding>
                  <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
               </padding>
               
               <!-- Removed Reset Button -->
               
               <!-- Summary Cards -->
            <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: linear-gradient(to right, #DC143C, #8B0000); -fx-background-radius: 12; -fx-padding: 20;">
               <VBox spacing="5.0">
                  <Label style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;" text="Transaction History" />
                  <Label fx:id="lblTransactionCount" style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px;" text="Total Transactions: 0" />
               </VBox>
               
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </HBox>
            
            <!-- Filter and Search Section -->
            <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
               <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="Filter Transactions" />
               
               <!-- First Row of Filters -->
               <HBox spacing="15.0" alignment="CENTER_LEFT">
                  <!-- Search by Order Number -->
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <Label style="-fx-font-size: 12px; -fx-text-fill: #4a5568;" text="Order Number" />
                     <TextField fx:id="txtSearchOrderNumber" promptText="Search by order number..." style="-fx-background-color: #f7fafc; -fx-border-color: #e2e8f0; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10; -fx-font-size: 13px;" prefWidth="220.0" maxWidth="Infinity" />
                  </VBox>
                  
                  <!-- Customer Filter -->
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <Label style="-fx-font-size: 12px; -fx-text-fill: #4a5568;" text="Customer" />
                     <TextField fx:id="txtCustomerFilter" promptText="Search customer name" style="-fx-background-color: #f7fafc; -fx-border-color: #e2e8f0; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8;" prefWidth="220.0" maxWidth="Infinity" />
                  </VBox>
                  
                  <!-- Payment Method Filter -->
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <Label style="-fx-font-size: 12px; -fx-text-fill: #4a5568;" text="Payment Method" />
                     <ComboBox fx:id="cmbPaymentMethodFilter" promptText="All Methods" style="-fx-background-color: #f7fafc; -fx-border-color: #e2e8f0; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8;" prefWidth="180.0" maxWidth="Infinity" />
                  </VBox>
               </HBox>
               
               <!-- Second Row of Filters -->
               <HBox spacing="15.0" alignment="CENTER_LEFT">
                  <!-- Date From -->
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <Label style="-fx-font-size: 12px; -fx-text-fill: #4a5568;" text="From Date" />
                     <DatePicker fx:id="dateFrom" promptText="Start Date" style="-fx-background-color: #f7fafc; -fx-border-color: #e2e8f0; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8;" prefWidth="180.0" maxWidth="Infinity" />
                  </VBox>
                  
                  <!-- Date To -->
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <Label style="-fx-font-size: 12px; -fx-text-fill: #4a5568;" text="To Date" />
                     <DatePicker fx:id="dateTo" promptText="End Date" style="-fx-background-color: #f7fafc; -fx-border-color: #e2e8f0; -fx-border-width: 2; -fx-border-radius: 8; -fx-background-radius: 8;" prefWidth="180.0" maxWidth="Infinity" />
                  </VBox>
                  
                  <!-- Filter Buttons -->
                  <VBox spacing="8.0" alignment="BOTTOM_LEFT">
                     <Label style="-fx-font-size: 12px; -fx-text-fill: transparent;" text="." />
                     <HBox spacing="10.0">
                        <Button fx:id="btnFilter" onAction="#handleFilter" style="-fx-background-color: #DC143C; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;" text="Apply Filter" />
                        <Button fx:id="btnClearFilter" onAction="#handleClearFilter" style="-fx-background-color: #718096; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;" text="Clear" />
                     </HBox>
                  </VBox>
               </HBox>
            </VBox>
            
            <!-- Transactions Table -->
            <VBox spacing="16.0" minHeight="400.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 6, 0, 0, 2);" VBox.vgrow="ALWAYS">
               <VBox spacing="4.0">
                  <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Transaction Records" />
                  <Label style="-fx-font-size: 12px; -fx-text-fill: #64748B;" text="Review and manage all recorded transactions." />
               </VBox>
               
               <Separator style="-fx-background-color: #E5E7EB;" />
               
               <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                  <TableView fx:id="tableTransactions" style="-fx-border-color: #E5E7EB; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13px;" VBox.vgrow="ALWAYS">
                     <placeholder>
                        <VBox alignment="CENTER" spacing="8.0">
                           <Label style="-fx-font-size: 24px; -fx-text-fill: #CBD5E1;" text="📋" />
                           <Label style="-fx-font-size: 13px; -fx-text-fill: #94A3B8;" text="No transaction records found." />
                        </VBox>
                     </placeholder>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <columns>
                        <TableColumn fx:id="colOrderNumber" minWidth="200.0" prefWidth="250.0" resizable="true" style="-fx-alignment: CENTER;" text="Order #" />
                        <TableColumn fx:id="colOrderDate" minWidth="130.0" prefWidth="145.0" resizable="true" style="-fx-alignment: CENTER;" text="Date &amp; Time" />
                        <TableColumn fx:id="colCustomerName" minWidth="120.0" prefWidth="150.0" resizable="true" style="-fx-alignment: CENTER;" text="Customer" />
                        <TableColumn fx:id="colTotalAmount" minWidth="80.0" prefWidth="100.0" resizable="true" style="-fx-alignment: CENTER;" text="Subtotal" />
                        <TableColumn fx:id="colDiscountAmount" minWidth="80.0" prefWidth="95.0" resizable="true" style="-fx-alignment: CENTER;" text="Discount" />
                        <TableColumn fx:id="colTaxAmount" minWidth="70.0" prefWidth="85.0" resizable="true" style="-fx-alignment: CENTER;" text="Tax" />
                        <TableColumn fx:id="colFinalAmount" minWidth="90.0" prefWidth="110.0" resizable="true" style="-fx-alignment: CENTER;" text="Total Amount" />
                        <TableColumn fx:id="colPaymentMethod" minWidth="100.0" prefWidth="120.0" resizable="true" style="-fx-alignment: CENTER;" text="Payment" />
                        <TableColumn fx:id="colPaymentStatus" minWidth="90.0" prefWidth="110.0" resizable="true" style="-fx-alignment: CENTER;" text="Status" />
                        <TableColumn fx:id="colUserName" minWidth="100.0" prefWidth="120.0" resizable="true" style="-fx-alignment: CENTER;" text="Cashier" />
                     </columns>
                  </TableView>
                  <HBox alignment="CENTER_RIGHT">
                     <Label style="-fx-font-size: 11px; -fx-text-fill: #94A3B8; -fx-font-style: italic;" text="Transaction records will seamlessly appear in the list above." />
                  </HBox>
               </VBox>
               
               <!-- Summary Stats -->
               <HBox spacing="20.0" alignment="CENTER_LEFT" style="-fx-padding: 15 0 0 0;">
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <Label style="-fx-font-size: 11px; -fx-text-fill: #718096; -fx-font-weight: bold;" text="TOTAL SALES" />
                     <Label fx:id="lblTotalSales" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3748;" text="₱0.00" />
                  </VBox>
                  
                  <Separator orientation="VERTICAL" prefHeight="40.0" style="-fx-background-color: #e2e8f0;" />
                  
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <Label style="-fx-font-size: 11px; -fx-text-fill: #718096; -fx-font-weight: bold;" text="TOTAL DISCOUNT" />
                     <Label fx:id="lblTotalDiscount" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #DC143C;" text="₱0.00" />
                  </VBox>
                  
                  <Separator orientation="VERTICAL" prefHeight="40.0" style="-fx-background-color: #e2e8f0;" />
                  
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <Label style="-fx-font-size: 11px; -fx-text-fill: #718096; -fx-font-weight: bold;" text="TOTAL TAX" />
                     <Label fx:id="lblTotalTax" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #4299e1;" text="₱0.00" />
                  </VBox>
                  
                  <Separator orientation="VERTICAL" prefHeight="40.0" style="-fx-background-color: #e2e8f0;" />
                  
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <Label style="-fx-font-size: 11px; -fx-text-fill: #718096; -fx-font-weight: bold;" text="NET TOTAL" />
                     <Label fx:id="lblNetTotal" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #48bb78;" text="₱0.00" />
                  </VBox>
               </HBox>
            </VBox>
            
            <!-- Action Buttons -->
            <HBox spacing="16.0" alignment="CENTER_RIGHT" style="-fx-padding: 8 0 0 0;">
               <Button fx:id="btnViewDetails" onAction="#handleViewDetails" style="-fx-background-color: #4299e1; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;" text="📋 View Details" minWidth="140" />
               <Button fx:id="btnReprintReceipt" onAction="#handleReprintReceipt" style="-fx-background-color: #48bb78; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;" text="🖨️ Reprint" minWidth="130" />
               <Button fx:id="btnExportToExcel" onAction="#handleExportToExcel" style="-fx-background-color: #38a169; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;" text="📊 Export CSV" minWidth="140" />
            </HBox>
            </VBox>
            </content>
         </ScrollPane>
   </children>
</AnchorPane>
