<AnchorPane minHeight="600.0" minWidth="800.0" prefHeight="832.0" prefWidth="1547.0" style="-fx-background-color: #f5f5f5;" stylesheets="@../../Model/application.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.homepagecontroller">
