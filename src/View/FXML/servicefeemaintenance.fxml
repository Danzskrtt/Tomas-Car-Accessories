<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f5f5f5;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.ServiceFeeMaintenanceController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         
         <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Service Fee Maintenance" />
         
         <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            
            <TableView fx:id="tableServiceFees" HBox.hgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                  <TableColumn fx:id="colServiceName" prefWidth="180.0" text="Service Name" />
                  <TableColumn fx:id="colCategory" prefWidth="120.0" text="Category" />
                  <TableColumn fx:id="colBaseFee" prefWidth="100.0" text="Base Fee" />
                  <TableColumn fx:id="colStatus" prefWidth="90.0" text="Status" />
               </columns>
            </TableView>

            <VBox prefWidth="300.0" spacing="12.0" style="-fx-background-color: white; -fx-padding: 15; -fx-border-color: #E5E7EB; -fx-border-radius: 8; -fx-background-radius: 8;">
               <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Service Details" />
               
               <VBox spacing="4.0">
                  <Label text="Service Name *" />
                  <TextField fx:id="txtServiceName" promptText="e.g. Full Synthetic Oil Change" />
               </VBox>
               
               <VBox spacing="4.0">
                  <Label text="Category" />
                  <ComboBox fx:id="cmbCategory" maxWidth="Infinity" promptText="Select Category" />
               </VBox>
               
               <VBox spacing="4.0">
                  <Label text="Base Fee (₱) *" />
                  <TextField fx:id="txtBaseFee" promptText="0.00" />
               </VBox>
               
               <VBox spacing="4.0">
                  <Label text="Status" />
                  <ComboBox fx:id="cmbStatus" maxWidth="Infinity" />
               </VBox>
               
               <VBox spacing="4.0" VBox.vgrow="ALWAYS">
                  <Label text="Description" />
                  <TextArea fx:id="txtDescription" prefRowCount="3" promptText="Optional details..." wrapText="true" />
               </VBox>
               
               <HBox spacing="10.0">
                  <Button fx:id="btnSave" maxWidth="Infinity" onAction="#handleSave" style="-fx-background-color: #0d6efd; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Save" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnClear" maxWidth="Infinity" onAction="#handleClear" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Clear" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnDelete" disable="true" maxWidth="Infinity" onAction="#handleDelete" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Delete" HBox.hgrow="ALWAYS" />
               </HBox>
            </VBox>
         </HBox>
      </VBox>
   </children>
</AnchorPane>