<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox fx:id="cardBox" alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="200.0" prefWidth="160.0" spacing="5.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2); -fx-cursor: hand;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.ProductCardController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <children>
      <ImageView fx:id="imgProduct" fitHeight="100.0" fitWidth="140.0" pickOnBounds="true" preserveRatio="true" />
      <Label fx:id="lblProductName" alignment="CENTER" prefHeight="40.0" prefWidth="140.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Product Name" textAlignment="CENTER" wrapText="true" />
      <HBox alignment="CENTER" spacing="10.0">
         <Label fx:id="lblPrice" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #DC143C;" text="₱0.00" />
      </HBox>
      <Label fx:id="lblStock" style="-fx-font-size: 12px; -fx-text-fill: #666666;" text="Stock: 0" />
   </children>
</VBox>
