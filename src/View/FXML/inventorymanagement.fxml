<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="600.0" minWidth="800.0" prefHeight="832.0" prefWidth="1547.0" style="-fx-background-color: #f5f5f5;" stylesheets="@../../Model/application.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.InventoryManagementController">
   <children>
      <!-- Left Navigation Sidebar -->
      <VBox alignment="TOP_CENTER" maxWidth="220.0" minWidth="220.0" spacing="5.0" style="-fx-background-color: linear-gradient(to bottom, #DC143C, #8B0000);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
         <padding>
            <Insets bottom="12.0" left="12.0" right="12.0" top="15.0" />
         </padding>
         
         <ImageView fitHeight="55.0" fitWidth="140.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@../pics/1000098939.png" />
            </image>
         </ImageView>
         
         <Separator style="-fx-background-color: rgba(255,255,255,0.3);">
            <VBox.margin>
               <Insets bottom="10.0" top="8.0" />
            </VBox.margin>
         </Separator>
         
         <!-- Dashboard Button -->
         <Button fx:id="btnDashboard" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleBack" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand;" text="Dashboard">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="🏠" />
            </graphic>
            <VBox.margin>
               <Insets bottom="8.0" />
            </VBox.margin>
         </Button>
         
         <!-- User Management Button -->
         <Button fx:id="btnUserManagement" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleUserManagement" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand;" text="User Management">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="👥" />
            </graphic>
            <VBox.margin>
               <Insets bottom="8.0" />
            </VBox.margin>
         </Button>
         
         <!-- Employee Management Button -->
         <Button fx:id="btnEmployeeManagement" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleEmployeeManagement" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand;" text="Employee">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="👔" />
            </graphic>
            <VBox.margin>
               <Insets bottom="8.0" />
            </VBox.margin>
         </Button>
         
         <!-- Customer Button -->
         <Button fx:id="btnCustomerManagement" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleCustomerManagement" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand;" text="Customer">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="👤" />
            </graphic>
            <VBox.margin>
               <Insets bottom="8.0" />
            </VBox.margin>
         </Button>
         
         <!-- Service Booking Button -->
         <Button fx:id="btnServiceBooking" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleServiceBooking" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand;" text="Service Booking">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="📅" />
            </graphic>
            <VBox.margin>
               <Insets bottom="8.0" />
            </VBox.margin>
         </Button>
         
         <!-- Inventory Button (Active) -->
         <Button fx:id="btnInventory" alignment="CENTER_LEFT" maxWidth="Infinity" style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand;" text="Inventory">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="📦" />
            </graphic>
            <VBox.margin>
               <Insets bottom="8.0" />
            </VBox.margin>
         </Button>
         
         <!-- Sales Button -->
         <Button fx:id="btnSales" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleSalesManagement" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand;" text="Sales">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="💰" />
            </graphic>
            <VBox.margin>
               <Insets bottom="8.0" />
            </VBox.margin>
         </Button>
         
         <!-- Transactions Button -->
         <Button fx:id="btnTransactions" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleTransactions" style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand;" text="Transactions">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="📋" />
            </graphic>
            <VBox.margin>
               <Insets bottom="8.0" />
            </VBox.margin>
         </Button>
         
         <!-- Spacer to push logout to bottom -->
         <Region VBox.vgrow="ALWAYS" minHeight="10.0" />
         
         <Separator style="-fx-background-color: rgba(255,255,255,0.3);">
            <VBox.margin>
               <Insets bottom="6.0" top="6.0" />
            </VBox.margin>
         </Separator>
         
         <!-- Logout Button -->
         <Button fx:id="btnLogout" alignment="CENTER_LEFT" maxWidth="Infinity" onAction="#handleLogout" style="-fx-background-color: rgba(255,0,0,0.3); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-padding: 12 15; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.3); -fx-border-width: 1; -fx-border-radius: 8;" text="Logout">
            <graphic>
               <Label style="-fx-text-fill: white; -fx-font-size: 16px;" text="🚪" />
            </graphic>
         </Button>
      </VBox>
      
      <!-- Main Content Area -->
      <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: #f5f5f5;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="220.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <content>
            <VBox spacing="25.0" style="-fx-background-color: #f5f5f5;">
               <padding>
                  <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
               </padding>
         
         <!-- Stats Cards -->
         <HBox alignment="CENTER" spacing="15.0" style="-fx-padding: 0;">
            <VBox alignment="CENTER" prefHeight="90.0" prefWidth="240.0" spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3); -fx-padding: 15;">
               <Label style="-fx-font-size: 13px; -fx-text-fill: #6c757d; -fx-font-weight: 600;" text="Total Products" />
               <Label fx:id="lblTotalProducts" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #DC143C;" text="0">
                  <font><Font name="System Bold" size="26.0" /></font>
               </Label>
            </VBox>
            
            <VBox alignment="CENTER" prefHeight="90.0" prefWidth="240.0" spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3); -fx-padding: 15;">
               <Label style="-fx-font-size: 13px; -fx-text-fill: #6c757d; -fx-font-weight: 600;" text="Low Stock Items" />
               <Label fx:id="lblLowStock" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #dc3545;" text="0">
                  <font><Font name="System Bold" size="26.0" /></font>
               </Label>
            </VBox>
            
            <VBox alignment="CENTER" prefHeight="90.0" prefWidth="240.0" spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3); -fx-padding: 15;">
               <Label style="-fx-font-size: 13px; -fx-text-fill: #6c757d; -fx-font-weight: 600;" text="Total Stock Value" />
               <Label fx:id="lblStockValue" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #28a745;" text="₱0.00">
                  <font><Font name="System Bold" size="26.0" /></font>
               </Label>
            </VBox>
            
            <VBox alignment="CENTER" prefHeight="90.0" prefWidth="240.0" spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3); -fx-padding: 15;">
               <Label style="-fx-font-size: 13px; -fx-text-fill: #6c757d; -fx-font-weight: 600;" text="Categories" />
               <Label fx:id="lblCategories" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #007bff;" text="0">
                  <font><Font name="System Bold" size="26.0" /></font>
               </Label>
            </VBox>
         </HBox>
         
         <!-- Search and Action Bar -->
         <FlowPane hgap="10.0" vgap="10.0" alignment="CENTER_LEFT" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3);">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <Label minWidth="-Infinity" style="-fx-font-size: 14px; -fx-font-weight: 600; -fx-text-fill: #2c3e50;" text="🔍" />
               <TextField fx:id="txtSearch" minWidth="150.0" prefWidth="220.0" promptText="Search products..." style="-fx-background-color: #f8f9fa; -fx-border-color: #e9ecef; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 8 12; -fx-font-size: 13px;" />
               <Button fx:id="btnSearch" minWidth="-Infinity" onAction="#handleSearch" style="-fx-background-color: #DC143C; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 8 16; -fx-background-radius: 8; -fx-cursor: hand;" text="Search" />
               <Button fx:id="btnRefresh" minWidth="-Infinity" onAction="#handleRefresh" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 8 16; -fx-background-radius: 8; -fx-cursor: hand;" text="🔄 Refresh" />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <Separator orientation="VERTICAL" />
               <ComboBox fx:id="cmbFilter" minWidth="-Infinity" prefWidth="130.0" promptText="All Products" style="-fx-background-radius: 8; -fx-font-size: 12px;" />
               <CheckBox fx:id="chkLowStockOnly" minWidth="-Infinity" onAction="#handleFilterChange" style="-fx-font-size: 12px;" text="Low Stock Only" />
            </HBox>

            <Region prefWidth="10.0" />

            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <Button fx:id="btnStockArrivals" minWidth="-Infinity" onAction="#handleStockArrivals" style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-cursor: hand;" text="Stock Arrivals" />
               <Button fx:id="btnStockHistory" minWidth="-Infinity" onAction="#handleStockHistory" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-cursor: hand;" text="Stock History" />
               <Button fx:id="btnAddProduct" minWidth="-Infinity" onAction="#handleAddProduct" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 8; -fx-cursor: hand;" text="+ Add Product" />
               <Label fx:id="lblProductCount" minWidth="-Infinity" style="-fx-font-size: 12px; -fx-text-fill: #6c757d; -fx-font-weight: 600; -fx-background-color: #f8f9fa; -fx-padding: 6 12; -fx-background-radius: 20;" text="Total: 0" />
            </HBox>
         </FlowPane>
         
         <!-- Products Table -->
         <VBox spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 3); -fx-padding: 20;" VBox.vgrow="ALWAYS">
            <!-- Table Header -->
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="📦 Product Inventory">
                  <font>
                     <Font name="System Bold" size="20.0" />
                  </font>
               </Label>
               <Region HBox.hgrow="ALWAYS" />
               <Label style="-fx-font-size: 12px; -fx-text-fill: #6c757d; -fx-font-style: italic;" text="Manage your inventory" />
            </HBox>
            
            <Separator style="-fx-background-color: #e9ecef;" />
            
            <!-- Products Table for List -->
            <TableView fx:id="tvProducts" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colImage" prefWidth="80.0" text="Image" />
                  <TableColumn fx:id="colCode" prefWidth="100.0" text="Code" />
                  <TableColumn fx:id="colName" prefWidth="250.0" text="Product Name" />
                  <TableColumn fx:id="colCategory" prefWidth="150.0" text="Category" />
                  <TableColumn fx:id="colPrice" prefWidth="120.0" text="Price" />
                  <TableColumn fx:id="colStock" prefWidth="100.0" text="Stock" />
                  <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
                  <TableColumn fx:id="colActions" prefWidth="290.0" minWidth="290.0" text="Actions" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>

            </VBox>
         </VBox>
         </content>
      </ScrollPane>
   </children>
</AnchorPane>
