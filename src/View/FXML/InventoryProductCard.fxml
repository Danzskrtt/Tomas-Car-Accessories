<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="cardBox" alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="260.0" prefWidth="180.0" spacing="8.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #e0e0e0; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller.InventoryProductCardController">
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
   <children>
      <ImageView fx:id="imgProduct" fitHeight="110.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true" />
      <Label fx:id="lblProductName" alignment="CENTER" prefHeight="40.0" prefWidth="150.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333333;" text="Product Name" textAlignment="CENTER" wrapText="true" />
      <Label fx:id="lblProductCode" style="-fx-font-size: 11px; -fx-text-fill: #888888;" text="Code: PROD-001" />
      
      <HBox alignment="CENTER" spacing="10.0">
         <Label fx:id="lblPrice" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #28a745;" text="₱0.00" />
      </HBox>
      
      <HBox alignment="CENTER" spacing="5.0">
         <Label style="-fx-font-size: 12px; -fx-text-fill: #666666;" text="Stock:" />
         <Label fx:id="lblStock" style="-fx-font-size: 13px; -fx-font-weight: bold;" text="0" />
      </HBox>
      <Region VBox.vgrow="ALWAYS" />
      <HBox alignment="CENTER" spacing="10.0">
         <Button fx:id="btnEdit" mnemonicParsing="false" onAction="#handleEdit" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-cursor: hand;" text="✏️ Edit" />
         <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#handleDelete" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-size: 11px; -fx-font-weight: bold; -fx-cursor: hand;" text="🗑️ Delete" />
      </HBox>
   </children>
</VBox>
